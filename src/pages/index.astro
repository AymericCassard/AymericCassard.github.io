---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Terminal">
  <div class="index-content framed">
    <h1 id="hello-there">Bonjour !</h1>
    <p>Je suis un étudiant en deuxième annèe de Master Informatique, parcours <strong>ASPIC</strong> (Systèmes Autonomes, perception, contrôle et interactions)</p>
    <p>Cette page recense les projets auxquels j'ai pu prendre part.</p>
    <p class="content">
    <Image style="align-self: center" src='/img/firstbot/firstbot.jpg' alt="Robot firstbot a deux roues motrices, équipé de lipo et caméra, posé sur une table" width={576} height={1024} />
    </p>
  </div>
  
  <div class="posts">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
